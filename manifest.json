{
  "manifest_version": 3,
  "name": "团务助手 - 团员信息管理",
  "version": "1.0.0",
  "description": "团务助手：智慧团建团务辅助，支持名单读取与 CSV 导出、重置验证码记录、评议批量设置、团员信息录入预检；数据本地处理，批量任务确认后提交。",
  "short_description": "智慧团建团务辅助：名单导出、验证码记录、评议批量设置与团员信息录入预检。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://zhtj.youth.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://zhtj.youth.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "https://zhtj.youth.cn/*"
      ]
    }
  ]
}
